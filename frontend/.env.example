# Required by the frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Legacy UPI reconciliation (frontend/src/lib/upi/, ported from
# https://github.com/codemodeai/codemode-upi-pay, MIT). New customer checkouts
# use Razorpay. Keep these only while reconciling outstanding UPI records.
# These values run server-side; never prefix them with NEXT_PUBLIC_.
#
# Required:
#   UPI_VPA                   Your real UPI ID, e.g. yourshop@okhdfcbank
#   SUPABASE_SERVICE_ROLE_KEY Supabase project Settings -> API -> service_role
#                              key. Bypasses RLS -- the upi_* tables created by
#                              0122_upi_auto_pay.sql have RLS enabled with no
#                              policies specifically so only this key can
#                              reach them.
#
# Optional:
#   UPI_PAYEE_NAME             Shown in the customer's UPI app. Defaults to "Hanbee".
#   UPI_TEST_MODE               Set to "1" to enable simulatePayment() for
#                              testing without real Gmail/bank setup -- see
#                              POST /api/upi/payment/:id/simulate. Never set
#                              this in production.
#   UPI_GMAIL_ADDRESS          A dedicated Gmail inbox used only to receive
#                              bank credit-alert emails (not your UPI ID's
#                              own inbox -- a separate account you create).
#   UPI_GMAIL_APP_PASSWORD     That Gmail account's 16-character App Password
#                              (Google Account -> Security -> 2-Step
#                              Verification -> App passwords). Without this +
#                              UPI_GMAIL_ADDRESS, payments can't confirm
#                              automatically outside test mode.
UPI_VPA=
UPI_PAYEE_NAME=
UPI_TEST_MODE=
UPI_GMAIL_ADDRESS=
UPI_GMAIL_APP_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=

# Required for the public /apply form's CAPTCHA widget (Cloudflare Turnstile
# site key -- public by design, pairs with TURNSTILE_SECRET_KEY set as an
# Edge Function secret for the submit-application function, never here)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Razorpay Standard Checkout (server-side only; never use NEXT_PUBLIC_ here)
# Configure these in the frontend host's production environment and previews
# only with Razorpay test credentials. Add the webhook URL and secret from
# docs/RAZORPAY_ONBOARDING.md after applying migration 0129.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Assistant Edge Function configuration is separate from the frontend
# environment. Set these as Supabase Edge Function secrets; never expose them
# through NEXT_PUBLIC_* variables or put secret values in this file.
#
# Required/configured by the project:
#   ALLOWED_ORIGINS                 Comma-separated allowed browser origins
#   GEMINI_API_KEY                  Gemini API key
#   SUPABASE_URL                    Supabase-provided Edge Function variable
#   SUPABASE_ANON_KEY               Supabase-provided Edge Function variable
#   SUPABASE_SERVICE_ROLE_KEY       Supabase-provided; keep secret
#
# submit-application also needs (same ALLOWED_ORIGINS/SUPABASE_URL/
# SUPABASE_SERVICE_ROLE_KEY as above, plus):
#   TURNSTILE_SECRET_KEY            Cloudflare Turnstile secret key; pairs
#                                    with NEXT_PUBLIC_TURNSTILE_SITE_KEY above
#
# Optional:
#   GEMINI_PER_MINUTE_LIMIT         Unset disables the per-minute cap
#   GEMINI_DAILY_REQUEST_LIMIT      Defaults to 100
#   GEMINI_MODEL                    Defaults to gemini-flash-lite-latest
#   GEMINI_FALLBACK_MODEL           Defaults to gemini-flash-latest
#
# OAuth / session secrets (set as Supabase Edge Function secrets, not here):
#   GOOGLE_CLIENT_ID                Google OAuth client id
#   GOOGLE_CLIENT_SECRET            Google OAuth client secret
#   GOOGLE_CALLBACK_URL             Google OAuth callback URL
#   GITHUB_CLIENT_ID                GitHub OAuth client id
#   GITHUB_CLIENT_SECRET            GitHub OAuth client secret
#   GITHUB_CALLBACK_URL             GitHub OAuth callback URL
#   JWT_SECRET                      Signing secret for backend-issued JWTs
